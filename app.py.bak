from flask import Flask, request, jsonify
from auth import authenticate

app = Flask(__name__)

@app.route("/", methods=["GET"])
def root():
    return "OK", 200

@app.route("/login", methods=["POST"])
def login():
    raw = request.get_data(as_text=True)
    app.logger.debug("RAW BODY: %s", raw)
    data = request.get_json(silent=True)
    if data is None:
        return jsonify({"status":"error","message":"JSON invalide ou Content-Type manquant","raw": raw}), 400
    identifier = (data.get("identifier") or "").strip()
    password = data.get("password") or ""
    if not identifier or not password:
        return jsonify({"status":"error","message":"identifier and password required"}), 400
    user, err = authenticate(identifier, password)
    if user:
        return jsonify({"status":"ok","user":user}), 200
    return jsonify({"status":"error","message":err}), 401

if __name__ == "__main__":
    app.run(host="127.0.0.1", port=5000, debug=False, use_reloader=False)
